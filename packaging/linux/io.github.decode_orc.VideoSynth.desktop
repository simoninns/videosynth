[Desktop Entry]
Type=Application
Name=VideoSynth
GenericName=Video Signal Synthesizer
Comment=Generate PAL, PAL-M and NTSC composite and Y/C test signals
Exec=videosynth-gui
Icon=io.github.decode_orc.VideoSynth
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=PAL;PAL-M;NTSC;CVBS;composite;laserdisc;VBI;test signal;video;
StartupNotify=true
StartupWMClass=videosynth-gui
